<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <!-- Météo de l'accueil : position approximative et accès réseau (Open-Meteo). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Balayage vers le bas sur l'accueil : ouvrir le volet de notifications. -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Flow Island (Dynamic Island) : pilule animée autour de la caméra par-dessus les applis. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Flow"
        android:allowBackup="false"
        android:supportsRtl="true">
        <service
            android:name=".FlowIslandService"
            android:exported="false" />
        <service
            android:name=".FlowNotificationListener"
            android:label="Pastilles Flow"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".FlowSettingsActivity"
            android:label="Paramètres Flow"
            android:icon="@drawable/ic_flow_settings"
            android:taskAffinity="os.flow.launcher.settings"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
